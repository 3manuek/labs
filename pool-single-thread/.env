# ---------------------------------------------------------------------------
# pool-single-thread lab settings (read by docker compose and the Makefile)
# ---------------------------------------------------------------------------

# Image versions
POSTGRES_IMAGE=postgres:18
PGBOUNCER_VERSION=1.26.0
PROXYSQL_IMAGE=proxysql/proxysql:3.0.10
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.20.1
PGBOUNCER_EXPORTER_IMAGE=prometheuscommunity/pgbouncer-exporter:v0.12.1
SQL_EXPORTER_IMAGE=burningalchemist/sql_exporter:latest
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6
PROMETHEUS_IMAGE=prom/prometheus:latest
PUSHGATEWAY_IMAGE=prom/pushgateway:latest
GRAFANA_IMAGE=grafana/grafana:latest

# Test data: pgbench scale (10 => 1M accounts, ~150MB). Orders = ORDERS_PER_ACCOUNT * accounts.
# Kept small on purpose: the dataset must fit in shared_buffers so Postgres is never the bottleneck.
SCALE=10
ORDERS_PER_ACCOUNT=0.5

# Backend pool size is 20 for both poolers. To change it, edit BOTH:
#   docker/pgbouncer/pgbouncer.ini  (default_pool_size, max_db_connections)
#   docker/proxysql/proxysql.cnf    (pgsql_servers.max_connections)

# CPU pinning (cpuset). Needs >= 8 vCPUs in Docker Desktop (Settings > Resources).
# Each pooler gets exactly ONE dedicated core => single-thread comparison.
MON_CPUSET=0
PG_CPUSET=1-3
PGBOUNCER_CPUSET=4
PROXYSQL_CPUSET=5
BENCH_CPUSET=6-7

# Host ports (chosen to not collide with the other labs)
PG_PORT=15432
PGBOUNCER_PORT=16432
PROXYSQL_PORT=16133
PROXYSQL_ADMIN_PORT=16132
PROMETHEUS_PORT=19090
PUSHGATEWAY_PORT=19091
GRAFANA_PORT=13000
CADVISOR_PORT=18080
